# Copy this file to .env and fill in your values. Never commit .env.

# --- AI (Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_api_key_here

# --- Flask ---
# REQUIRED in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-long-random-secret

# --- Database ---
# Local dev default: SQLite file `acra.db` in the project root (created automatically).
# Production (Render / Postgres): paste the Internal Database URL, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# (postgres:// URLs are auto-converted to postgresql://)
DATABASE_URL=sqlite:///acra.db
