# Copy this file to .env and fill in your values. Never commit .env.

# --- AI (Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_api_key_here

# --- Flask ---
# REQUIRED in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-long-random-secret

# --- Database ---
# Local dev default: SQLite file `acra.db` in the project root (created automatically).
# Production (Render / Postgres): paste the Internal Database URL, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# (postgres:// URLs are auto-converted to postgresql://)
DATABASE_URL=sqlite:///acra.db

# --- Google Sign-In (OAuth 2.0) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Add BOTH redirect URIs:
#   http://localhost:5000/auth/google/callback
#   https://ai-career-research-assistant-resume.onrender.com/auth/google/callback
# If these are unset, Google sign-in is hidden automatically (email login still works).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- GitHub API (optional) ---
# Raises the GitHub API rate limit 60 -> 5000 req/hour (used by the paper
# constructor + GitHub profile analyzer). Create at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
